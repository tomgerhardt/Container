rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Group resource images — must be authenticated
    match /groups/{groupId}/resources/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024 // 10MB
        && request.resource.contentType.matches('image/.*');
    }

    // Library resource images — anyone authenticated can read, only super admins write
    // (Super admin enforcement relies on Firestore; storage just checks auth)
    match /library/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // User avatars come directly from Google — no upload needed
  }
}
